# Package
PACKAGE_NAME=velari

# Docker
DOCKER_USER=akamlani

# Dotfile repository configuration
GIT_USER=akamlani
DOTFILES_REMOTE=dotfiles

VAULTSPACE_ROOT=$(HOME)/Dropbox/dev-vault/workspace

# Use HTTPS so clone works without SSH keys; use git@github.com:$(GIT_USER)/dotfiles.git for SSH
DOTFILES_REPO=https://github.com/$(GIT_USER)/$(DOTFILES_REMOTE).git
DOTFILES_DIR=_build/$(DOTFILES_REMOTE)
BRANCH=main

SKILLS_REPO=https://github.com/akamlani/agent-skills
SKILLS_DIR=_build/agent-skills

MCP_SERVERS = \
    phoenix-docs@https://arizeai-433a7140.mintlify.app/mcp

# format: name^command^arg1,arg2,...
MCP_SERVERS_STDIO = \
	chrome-devtools^npx^-y,chrome-devtools-mcp@latest

# Jupyter Kernels — `make install_kernel` defaults; override per invocation, e.g.:
#   make install_kernel KERNEL_NAME=nlp KERNEL_DEPS="transformers torch"
KERNEL_NAME=ml
KERNEL_DEPS=datasetsforecast
KERNEL_VENV_DIR=.venv-$(KERNEL_NAME)
KERNEL_ID=$(PACKAGE_NAME)-$(KERNEL_NAME)
KERNEL_DISPLAY=$(PACKAGE_NAME) ($(KERNEL_NAME))
